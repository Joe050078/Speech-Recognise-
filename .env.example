# ── ASR Engine ───────────────────────────────────────────────────────────────
ASR_ENGINE=whisper
WHISPER_MODEL=base
LANGUAGE=en

# ── Audio ────────────────────────────────────────────────────────────────────
SAMPLE_RATE=16000
MAX_DURATION=60

# ── Google Speech API (optional) ─────────────────────────────────────────────
# GOOGLE_API_KEY=your_google_cloud_api_key_here

# ── API Server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
